
# Saleor backend - production-style environment

# Database
DATABASE_URL=postgres://saleor:saleor@postgres:5432/saleor

# Cache and Celery
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1

# Django secret key
# Replace with the same persistent secret currently used by your setup.
SECRET_KEY=REPLACE_WITH_YOUR_SALEOR_SECRET_KEY

# Email
DEFAULT_FROM_EMAIL=noreply@childnest.co.uk
EMAIL_URL=smtp://mailpit:1025

# OpenTelemetry
OTEL_SERVICE_NAME=saleor
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
