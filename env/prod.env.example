# =============================================================================
# Saleor prod-style stack - PRODUCTION mode environment sample
#
# Copy to `.env` (gitignored) when deploying the REAL production configuration:
#   cp env/prod.env.example .env
#
# Used by:
#   docker compose --env-file .env -f docker-compose.prod.yml \
#     -f docker-compose.traefik.prod.yml up -d
#
# PREREQUISITES (all must be true before running this mode):
#   * Public A records: shop/dashboard/api/store-fe.childnest.co.uk
#     all point at the production host.
#   * Ports 80 and 443 are free on that host.
#   * Plain Linux Docker daemon (so /var/run/docker.sock can be mounted
#     read-only) - NOT Docker Desktop for Windows.
#   * The .secrets/saleor_rsa.pem private key + a strong SALEOR_SECRET_KEY.
#
# In production NOTHING requests Let's Encrypt until this overlay starts.
# ACME then requests certificates for the four domains on first boot.
# =============================================================================

# --- secrets: REPLACE, never commit the real values -------------------------
SALEOR_SECRET_KEY=CHANGE-ME-long-random-value
# .secrets/saleor_rsa.pem must exist on the host (gitignored).

# --- database ----------------------------------------------------------------
# Value matches the current externally managed PostgreSQL 18 - verify before
# trusting it, and use a strong password / TLS parameters for real prod.
DATABASE_URL=postgres://saleor:saleor@postgres:5432/saleor

# --- cache / broker -----------------------------------------------------------
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1

# --- public URLs (PRODUCTION: no port suffix) ---------------------------------
PUBLIC_URL=https://api.childnest.co.uk/
DASHBOARD_URL=https://dashboard.childnest.co.uk/
DASHBOARD_API_URL=https://api.childnest.co.uk/graphql/

SALEOR_ALLOWED_HOSTS=api.childnest.co.uk,api
SALEOR_ALLOWED_CLIENT_HOSTS=https://dashboard.childnest.co.uk,https://api.childnest.co.uk,https://shop.childnest.co.uk,https://store-fe.childnest.co.uk
SALEOR_CSRF_TRUSTED_ORIGINS=https://dashboard.childnest.co.uk

# --- mail ---------------------------------------------------------------------
# Replace with a real SMTP provider for production delivery.
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@childnest.co.uk

# --- tracing ------------------------------------------------------------------
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME_WORKER=saleor-worker

# --- HTTP IP filter (recommended production value) -----------------------------
HTTP_IP_FILTER_ENABLED=True
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=False

# --- Let's Encrypt (required for this mode) ------------------------------------
ACME_EMAIL=admin@childnest.co.uk

# --- Paper storefront (build args, when its image is published) ----------------
# The public API URL is BAKED INTO the Next.js build - a separate build is
# required for local vs production. See docs/production-traefik.md.
# NEXT_PUBLIC_SALEOR_API_URL=https://api.childnest.co.uk/graphql/
# NEXT_PUBLIC_STOREFRONT_URL=https://shop.childnest.co.uk
