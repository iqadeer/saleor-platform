# =============================================================================
# Saleor prod-style stack - LOCAL mode environment sample
#
# Copy to `.env` in the repo root (`.env` is gitignored) and edit:
#   cp env/local.env.example .env
#
# Used by:
#   docker compose --env-file .env -f docker-compose.prod.yml \
#     -f docker-compose.traefik.local.yml up -d
#
# LOCAL MODE: domains resolve through the Windows hosts file to 127.0.0.1;
# TLS is the mkcert certificate (traefik/certs/); Traefik listens on
# 127.0.0.1:80 (http) / 127.0.0.1:443 (https).
# No Let's Encrypt is involved in this mode.
# =============================================================================

# --- secrets: REPLACE, never commit the real values -------------------------
# Long random string (e.g. `python -c "import secrets;print(secrets.token_hex(50))"`)
SALEOR_SECRET_KEY=9fff8972789e198be5742a2f103335d9d6a10fff78dbe8b9f79041268a6f60abcb1469d9b4db49903bb071a1b2aeec3a32ca

# RSA key pair used by Saleor to sign app/JWT tokens.
# Generate once:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 -out key.pem
#                 openssl pkey -in key.pem -pubout -out pub.pem
# Put the PRIVATE key file at .secrets/saleor_rsa.pem (gitignored).

# --- database (externally managed PostgreSQL 18 - value matches the current
#     working setup; do NOT change without checking) --------------------------
DATABASE_URL=postgres://saleor:saleor@postgres:5432/saleor

# --- cache / broker (Valkey container name `cache`) --------------------------
CACHE_URL=redis://cache:6379/0
CELERY_BROKER_URL=redis://cache:6379/1

# --- public URLs (LOCAL: plain 443, same form as production) ----------------
# MUST be identical on api and worker (both read the same .env).

# PUBLIC_URL=https://api.childnest.co.uk:8443/
# DASHBOARD_URL=https://dashboard.childnest.co.uk:8443/
# DASHBOARD_API_URL=https://api.childnest.co.uk:8443/graphql/
PUBLIC_URL=http://localhost:8001/
DASHBOARD_URL=http://localhost:9001/
DASHBOARD_API_URL=http://localhost:8001/graphql/

# Hosts the API accepts in the HTTP Host header (browser goes through
# Traefik, so the Host header carries the public domain, no port).
# SALEOR_ALLOWED_HOSTS=host.docker.internal,api.childnest.co.uk,localhost,127.0.0.1,api
SALEOR_ALLOWED_HOSTS=localhost,127.0.0.1,api,host.docker.internal
# Browser origins allowed to call the API (CORS/CSRF): dashboard + future
# storefront hosts (certs ready, routing out of scope) + dev-loopback URLs so
# the existing local dev flow keeps working during the transition.
# SALEOR_ALLOWED_CLIENT_HOSTS=https://dashboard.childnest.co.uk:8443,https://api.childnest.co.uk:8443,https://shop.childnest.co.uk:8443,https://store-fe.childnest.co.uk:8443,http://localhost:9001,http://localhost:8001
# SALEOR_CSRF_TRUSTED_ORIGINS=https://dashboard.childnest.co.uk:8443,http://localhost:9001
# SALEOR_ALLOWED_CLIENT_HOSTS=http://localhost:8001,http://localhost:9001,https://shop.childnest.co.uk:8443,https://store-fe.childnest.co.uk:8443,http://localhost:9001,http://localhost:8001
SALEOR_ALLOWED_CLIENT_HOSTS=http://localhost:9001,http://localhost:8001
SALEOR_CSRF_TRUSTED_ORIGINS=http://localhost:9001
# SALEOR_CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://localhost:9001
# --- mail (Mailpit container; internal only) ---------------------------------
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=noreply@childnest.co.uk

# --- tracing (temporary Jaeger service, internal) ----------------------------
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME_WORKER=saleor-worker

# --- HTTP IP filter (local mode: allow loopback for local app development) ----
HTTP_IP_FILTER_ENABLED=False
HTTP_IP_FILTER_ALLOW_LOOPBACK_IPS=True
DEBUG=False
# --- only needed for PRODUCTION mode (ignored in local) -----------------------
# ACME_EMAIL=admin@childnest.co.uk

# --- Paper storefront: OUT OF SCOPE for this phase (separate task) ----------
# When integrated later it will need these build args (baked at build time):
# NEXT_PUBLIC_SALEOR_API_URL=https://api.childnest.co.uk/graphql/
# NEXT_PUBLIC_STOREFRONT_URL=https://shop.childnest.co.uk
