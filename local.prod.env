
# =============================================================================
# Saleor production-style stack - LOCAL mode
# Docker Compose interpolation variables
#
# Used with:
# docker compose --env-file .env -f docker-compose.prod.yml up -d
#
# This file is gitignored. Never commit real secrets.
# =============================================================================

# --- Django secret key -------------------------------------------------------
# Generate a new persistent secret before production.
SALEOR_SECRET_KEY=9fff8972789e198be5742a2f103335d9d6a10fff78dbe8b9f79041268a6f60abcb1469d9b4db49903bb071a1b2aeec3a32ca

# --- Public URLs (local direct access) ---------------------------------------
PUBLIC_URL=http://localhost:8001/
DASHBOARD_URL=http://localhost:9001/
DASHBOARD_API_URL=http://localhost:8001/graphql/

# --- API host allowlist ------------------------------------------------------
SALEOR_ALLOWED_HOSTS=localhost,127.0.0.1,api,host.docker.internal

# --- Browser origin allowlists -----------------------------------------------
SALEOR_ALLOWED_CLIENT_HOSTS=http://localhost:9001,http://localhost:8001
SALEOR_CSRF_TRUSTED_ORIGINS=http://localhost:9001
